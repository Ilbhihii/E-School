APP_NAME="Smart School Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smart-school-academy.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Browser origins allowed to call /api/*. Flutter native is not restricted by CORS.
CORS_ALLOWED_ORIGINS=https://smart-school-academy.com

# Keep your real database/mail/payment credentials only in .env on the VPS.

# Firebase / notifications push (Chrome, Edge, Firefox, Opera + app mobile)
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_CREDENTIALS=/var/www/e-school/storage/app/firebase/service-account.json
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
